{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent/claude-code/forward.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/agent/claude-code/forward.py\"",
            "timeout": 10
          }
        ]
      }
    ],
